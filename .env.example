# Copy to .env and keep it on this machine. Never commit filled values.
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Optional for video-only work; required for official public-account drafts.
WECHAT_APPID=
WECHAT_APPSECRET=

CODEX_BIN=codex
# Empty means use your Codex configuration default.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=14400
# Optional executable overrides; otherwise use PATH/browser-managed installation.
FFMPEG_BINARY=
CHROME_BINARY=
